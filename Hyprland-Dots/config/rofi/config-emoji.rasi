/* Main Config - emoji */

@import "~/.config/rofi/config.rasi" 

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}

/* ---- Window ---- */
/* A fixed size, nearly the whole screen. Sized by its content, the window
   opened as a thin strip and grew while rofi was still reading the emoji list,
   and Hyprland animated the growth - so it never opened like the launcher,
   whose size is fixed too. */
window {
  width: 92%;
  height: 90%;
}

/* ---- Entry ---- */
entry {
  width: 37%;
  placeholder: " Эмодзи";
  horizontal-align: 0.0;
}

/* ---- Listview ---- */
listview {
  columns: 6;
  fixed-height: true;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  padding: 0px;
  margin: 0px;
}