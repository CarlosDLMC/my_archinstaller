# btop in the wallpaper's colours - wallust template, rendered to
# ~/.config/btop/themes/wallust.theme on every wallpaper change (wallust.toml).
#
# «Спектр»: each box in its own wallust colour. CPU and processes take the
# accent (color7), memory the window border's slot (color12, lifted), network
# the alert slot (color14) with upload in the accent's complementary colour,
# so download and upload never blur together. Each box's frame is a dark tint
# of its colour; the process box stays neutral.
#
# The rest stays calm, like the bar: text and titles are the foreground with
# saturate(-0.85) - a soft white with a whisper of the hue - labels a
# desaturated color8, and graphs and meters start dark and rise to their colour
# as they fill. Load-type readings (CPU, temperature, processes, used memory)
# end in the alert hue; readings that are good when high (free, available,
# cached) stop at their own colour. Straight wallust slots everywhere had made
# btop a wall of one colour on single-hue palettes (an all-green osaka-jade).

theme[main_bg]=""
theme[main_fg]="{{foreground | saturate(-0.85)}}"
theme[title]="{{foreground | saturate(-0.85)}}"
theme[hi_fg]="{{color7}}"
theme[selected_bg]="{{color7 | saturate(-0.4) | darken(0.6)}}"
theme[selected_fg]="{{foreground | saturate(-0.85)}}"
theme[inactive_fg]="{{color8 | saturate(-0.7)}}"
theme[graph_text]="{{color8 | saturate(-0.7)}}"
theme[meter_bg]="{{color8 | saturate(-0.8) | darken(0.6)}}"
theme[proc_misc]="{{color7}}"
theme[cpu_box]="{{color7 | saturate(-0.2) | darken(0.5)}}"
theme[mem_box]="{{color12 | lighten(0.35) | saturate(-0.2) | darken(0.5)}}"
theme[net_box]="{{color14 | lighten(0.2) | saturate(-0.2) | darken(0.5)}}"
theme[proc_box]="{{color8 | saturate(-0.8) | darken(0.4)}}"
theme[div_line]="{{color8 | saturate(-0.8) | darken(0.5)}}"
theme[temp_start]="{{color7 | saturate(-0.2) | darken(0.5)}}"
theme[temp_mid]="{{color7}}"
theme[temp_end]="{{color14}}"
theme[cpu_start]="{{color7 | saturate(-0.2) | darken(0.55)}}"
theme[cpu_mid]="{{color7}}"
theme[cpu_end]="{{color7 | lighten(0.6)}}"
theme[process_start]="{{color7 | saturate(-0.2) | darken(0.55)}}"
theme[process_mid]="{{color7}}"
theme[process_end]="{{color7 | lighten(0.6)}}"
theme[used_start]="{{color12 | lighten(0.35) | darken(0.5)}}"
theme[used_mid]="{{color12 | lighten(0.35)}}"
theme[used_end]="{{color14}}"
theme[free_start]="{{color12 | lighten(0.35) | darken(0.5)}}"
theme[free_mid]="{{color12 | lighten(0.35) | darken(0.2)}}"
theme[free_end]="{{color12 | lighten(0.35)}}"
theme[available_start]="{{color12 | lighten(0.35) | darken(0.5)}}"
theme[available_mid]="{{color12 | lighten(0.35) | darken(0.2)}}"
theme[available_end]="{{color12 | lighten(0.35)}}"
theme[cached_start]="{{color12 | lighten(0.35) | darken(0.5)}}"
theme[cached_mid]="{{color12 | lighten(0.35) | darken(0.2)}}"
theme[cached_end]="{{color12 | lighten(0.35)}}"
theme[download_start]="{{color14 | lighten(0.2) | darken(0.5)}}"
theme[download_mid]="{{color14 | lighten(0.2)}}"
theme[download_end]="{{color14 | lighten(0.6)}}"
theme[upload_start]="{{color7 | complementary | darken(0.5)}}"
theme[upload_mid]="{{color7 | complementary}}"
theme[upload_end]="{{color7 | complementary | lighten(0.6)}}"
