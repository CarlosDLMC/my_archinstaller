 /* wallust template - colors-rofi */

* {
active-background: #067263;
active-foreground: #A9E6DD;
normal-background: #222827;
normal-foreground: #A9E6DD;
urgent-background: #07A78F;
urgent-foreground: #A9E6DD;

alternate-active-background: #04743E;
alternate-active-foreground: #A9E6DD;
alternate-normal-background: #222827;
alternate-normal-foreground: #A9E6DD;
alternate-urgent-background: #222827;
alternate-urgent-foreground: #A9E6DD;

selected-active-background: #07A78F;
selected-active-foreground: #A9E6DD;
selected-normal-background: #07A78F;
selected-normal-foreground: #A9E6DD;
selected-urgent-background: #067263;
selected-urgent-foreground: #A9E6DD;

background-color: #222827;
background: rgba(0,0,0,0.7);
foreground: #A9E6DD;
border-color: #067263;

color0: #474D4D;
color1: #02211F;
color2: #022824;
color3: #03572F;
color4: #04554A;
color5: #067D6B;
color6: #068A76;
color7: #7BD3C6;
color8: #56948A;
color9: #032C29;
color10: #033530;
color11: #04743E;
color12: #067263;
color13: #07A78F;
color14: #08B89D;
color15: #7BD3C6;

/* Readable text for each slot above.

   A theme that uses @colorN as a fill prints @on-colorN on top of it instead
   of guessing. The default is @background - the very value the themes have
   always printed - so this file on its own behaves exactly as it used to, and
   it keeps tracking the rgba() literal above, which DarkLight.sh rewrites
   when it flips to light mode. RofiContrast.py (a wallust hook) then measures
   each pair and swaps in @foreground for the slots where @background cannot
   be read, leaving every other line untouched. */
on-color0: @background;
on-color1: @background;
on-color2: @background;
on-color3: @background;
on-color4: @background;
on-color5: @background;
on-color6: @background;
on-color7: @background;
on-color8: @background;
on-color9: @background;
on-color10: @background;
on-color11: @background;
on-color12: @background;
on-color13: @background;
on-color14: @background;
on-color15: @background;


}

