# btop in the wallpaper's colours - wallust template, rendered to
# ~/.config/btop/themes/wallust.theme on every wallpaper change (wallust.toml).
#
# «Спектр»: each box in its own wallust colour. CPU and processes take the
# accent (color7), memory the window border's slot (color12, lifted), network
# the alert slot (color14) with upload in the accent's complementary colour,
# so download and upload never blur together. Each box's frame is a dark tint
# of its colour; the process box stays neutral.
#
# The rest stays calm, like the bar: text and titles are the foreground with
# saturate(-0.85) - a soft white with a whisper of the hue - labels a
# desaturated color8, and graphs and meters start dark and rise to their colour
# as they fill. Load-type readings (CPU, temperature, processes, used memory)
# end in the alert hue; readings that are good when high (free, available,
# cached) stop at their own colour. Straight wallust slots everywhere had made
# btop a wall of one colour on single-hue palettes (an all-green osaka-jade).

theme[main_bg]=""
theme[main_fg]="#E8E3E2"
theme[title]="#E8E3E2"
theme[hi_fg]="#D6A29C"
theme[selected_bg]="#564948"
theme[selected_fg]="#E8E3E2"
theme[inactive_fg]="#968B8A"
theme[graph_text]="#968B8A"
theme[meter_bg]="#3C3939"
theme[proc_misc]="#D6A29C"
theme[cpu_box]="#6B5654"
theme[mem_box]="#4A3F3E"
theme[net_box]="#664440"
theme[proc_box]="#5A5655"
theme[div_line]="#4B4847"
theme[temp_start]="#6B5654"
theme[temp_mid]="#D6A29C"
theme[temp_end]="#BE564A"
theme[cpu_start]="#604D4C"
theme[cpu_mid]="#D6A29C"
theme[cpu_end]="#EFDAD7"
theme[process_start]="#604D4C"
theme[process_mid]="#D6A29C"
theme[process_end]="#EFDAD7"
theme[used_start]="#4A3C3B"
theme[used_mid]="#937876"
theme[used_end]="#BE564A"
theme[free_start]="#4A3C3B"
theme[free_mid]="#76605E"
theme[free_end]="#937876"
theme[available_start]="#4A3C3B"
theme[available_mid]="#76605E"
theme[available_end]="#937876"
theme[cached_start]="#4A3C3B"
