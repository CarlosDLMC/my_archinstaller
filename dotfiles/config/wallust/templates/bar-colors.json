{
    "_comment": "wallust template - rust-bar. Monochrome ramp; the alert colour is picked from hues by the bar (alert_from in rust-bar/src/theme.rs).",

    "bg":     "{{background}}",
    "fg":     "{{foreground}}",

    "bright": "{{color15}}",
    "dim":    "{{color8}}",
    "muted":  "{{color5}}",
    "faint":  "{{color0}}",

    "accent": "{{color7}}",
    "hues":   ["{{color1}}", "{{color2}}", "{{color3}}", "{{color4}}", "{{color5}}", "{{color6}}",
               "{{color9}}", "{{color10}}", "{{color11}}", "{{color12}}", "{{color13}}", "{{color14}}"],
    "warn":   "{{color6}}",
    "border": "{{color12}}"
}
