#!/usr/bin/env python3
"""Keep $num sidebar tokens in sync with herdr's live workspace numbering.

herdr exposes no event stream, so this polls. It only writes when the
(workspace_id -> number) mapping actually changes, so it is idle most of
the time.

While no herdr server is running it does not exit - the unit's
Restart=always would only start it again 5 s later. It waits instead: every
3 s it checks that the server's socket exists, which is a stat and not a
process, and it asks herdr itself only every 30 s, in case the socket lives
somewhere this does not know about.
"""
import json
import os
import subprocess
import time

HERDR = os.path.expanduser("~/.local/bin/herdr")
# What `herdr workspace list` connects to: HERDR_SOCKET_PATH, else the default
# session's socket.
SOCKET = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
last = None
asked = None

while True:
    if not os.path.exists(SOCKET) and asked is not None and time.monotonic() - asked < 30:
        time.sleep(3)
        continue
    asked = time.monotonic()
    try:
        out = subprocess.run([HERDR, "workspace", "list"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0:
            ws = json.loads(out.stdout)["result"]["workspaces"]
            cur = {w["workspace_id"]: w["number"] for w in ws}
            stale = any(str(w.get("tokens", {}).get("num")) != str(w["number"]) for w in ws)
            if cur != last or stale:
                for w in ws:
                    subprocess.run(
                        [HERDR, "workspace", "report-metadata", w["workspace_id"],
                         "--source", "numbering", "--token", "num=%s" % w["number"]],
                        capture_output=True, timeout=10)
                last = cur
    except Exception:
        last = None
    time.sleep(3)
