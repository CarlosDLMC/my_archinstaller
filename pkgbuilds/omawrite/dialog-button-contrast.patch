@@ -6,8 +6,17 @@
 
     property bool primary: false
     property bool darkMode: true
-    property color labelColor: primary ? "#ffffff" : "#d0d0d0"
     property color activeColor: "#428bca"
+    // my_archinstaller patch: activeColor is the theme's accent, and wallust can
+    // make that near-white - the fixed white label then vanished into it. Take
+    // whichever of dark or white contrasts more with the accent (WCAG ratio).
+    readonly property color primaryLabelColor: {
+        var l = 0.2126 * linearChannel(activeColor.r) + 0.7152 * linearChannel(activeColor.g)
+            + 0.0722 * linearChannel(activeColor.b);
+        // #1a1a1a, the dialog's own background, has a luminance of about 0.010.
+        return (l + 0.05) / 0.06 > 1.05 / (l + 0.05) ? "#1a1a1a" : "#ffffff";
+    }
+    property color labelColor: primary ? primaryLabelColor : "#d0d0d0"
     property real textScale: 1
     property string formattedText: ""
 
@@ -16,6 +25,10 @@
     topPadding: 7
     bottomPadding: 7
 
+    function linearChannel(c) {
+        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+    }
+
     Keys.onReturnPressed: clicked()
     Keys.onEnterPressed: clicked()
 
