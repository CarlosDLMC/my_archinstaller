# Vendored from omarchy's package repo:
#   https://github.com/omacom/omarchy-pkgs/tree/master/pkgbuilds/omawrite
# The AUR's omawrite is stale (0.5.0, under the old omacom-io org), so
# install-scripts/omarchy-apps.sh builds this copy with makepkg. To update,
# take pkgver and sha256sums from that file again and keep the change below.
#
# One change from omarchy's copy: /usr/bin/omawrite is a wrapper that runs the
# real binary (moved to /usr/lib/omawrite/) with QT_QPA_PLATFORMTHEME=
# xdgdesktopportal. omawrite's Open/Save use Qt Quick's FileDialog, which is
# only a real system dialog when the platform theme provides one. This session
# sets qt6ct, which does not, so Qt drew its own unthemed Material fallback.
# Through the portal the dialog is xdg-desktop-portal-gtk's GTK chooser, which
# follows the wallust GTK theme. omawrite itself already does this switch for
# omarchy's "gtk3" (src/main.cpp) - just not for qt6ct.
# The wrapper also runs omawrite in its own systemd scope capped at 4G RAM and
# no swap: a 16 MB file with megabyte-long lines (a Claude .jsonl) made the
# wrapped, highlighted layout grow to ~30G and systemd-oomd killed the whole
# login session. Now only omawrite dies.
#
# And five patches:
#  - single-line-return.patch: Return ends a paragraph with one line break
#    instead of two (lists and code fences behave as before), and Shift+Return
#    gives the blank-line paragraph break that Return used to. Backspace then
#    takes back one break, not the pair.
#  - theme-only-dialogs.patch: omawrite colours itself from omarchy's theme
#    file, which wallust writes here (omarchy-colors.toml). Only the Unsaved
#    changes and Changed-on-disk dialogs keep those colours; the window and
#    the Markdown highlighting use omawrite's own. Also gives modal dialogs a
#    dark dim layer - Qt 6.12's Material style dims with #99fafafa even in
#    dark mode, a near-white sheet over the page.
#  - dialog-button-contrast.patch: the highlighted dialog button (Reload, and
#    Keep Mine for a deleted file) is filled with the theme accent but had a
#    fixed white label, unreadable on the near-white accents wallust can
#    produce. The label is now dark or white, whichever contrasts more;
#    hover/press/border shades follow the accent too.
#  - unsaved-dialog-look.patch: in the Unsaved changes dialog Save is a plain
#    button like Cancel and Discard, every text is 4px larger, and the dialog
#    is 520px wide instead of 420 so the question still fits on one line.
#  - translucent-page.patch: the page background is 90% opaque and the text
#    fully opaque, the way foot's alpha works, so omawrite matches the
#    terminals. The hypr window rule for omawrite (UserConfigs/WindowRules.lua)
#    only adds the drop to ~80% when it loses focus.
# pkgrel is bumped for these.
#
# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omawrite
pkgver=0.7.1
pkgrel=9
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omawrite'
license=('MIT' 'OFL-1.1')
install='omawrite.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/omacom/omawrite/archive/refs/tags/v$pkgver.tar.gz"
        'single-line-return.patch'
        'theme-only-dialogs.patch'
        'dialog-button-contrast.patch'
        'unsaved-dialog-look.patch'
        'translucent-page.patch')
sha256sums=('a8742839163d69cd8dbd2d7eb116caba4c0dc941d017e54598e796d900aea68f'
            '424c5e57ddb02e6f221d9844e222429c5166f801315b27a845c54225c026bbd3'
            '047f7eaafb8ed8f0ee15805ac048917c2bbbd3c8e8efb124d84082659e633503'
            'bca13f419463fff82d52ea3c4b3eb305fb211795735ffc4a5760e9a30423533b'
            '104104fe4a45afbdfa1def522028cc52efde6a9369ca2e0591523feb0bdd6b12'
            '37b6037537488ee4f2f11a0b0b4c13a454fe4a55f55c84c5389e60473bb71c21')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/single-line-return.patch"
  patch -Np1 -i "$srcdir/theme-only-dialogs.patch"
  patch -Np1 -i "$srcdir/dialog-button-contrast.patch"
  patch -Np1 -i "$srcdir/unsaved-dialog-look.patch"
  patch -Np1 -i "$srcdir/translucent-page.patch"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omawrite "$pkgdir/usr/lib/omawrite/omawrite"
  install -dm755 "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' \
    '# Portal file dialogs instead of Qt Quick'"'"'s fallback - see the PKGBUILD.' \
    'export QT_QPA_PLATFORMTHEME=xdgdesktopportal' \
    '# Own scope capped at 4G, no swap: a huge file kills omawrite, not the session.' \
    'if systemd-run --user --quiet true 2>/dev/null; then' \
    '  exec systemd-run --user --scope --quiet --collect -p MemoryMax=4G -p MemorySwapMax=0 \' \
    '    /usr/lib/omawrite/omawrite "$@"' \
    'fi' \
    'exec /usr/lib/omawrite/omawrite "$@"' \
    > "$pkgdir/usr/bin/omawrite"
  chmod 755 "$pkgdir/usr/bin/omawrite"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 pkgbuild/omawrite.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawrite.svg"
  install -Dm644 pkgbuild/omawrite.desktop "$pkgdir/usr/share/applications/omawrite.desktop"
}
