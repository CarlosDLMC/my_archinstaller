+// my_archinstaller patch: the editor keeps omawrite's own colours whatever the
+// theme file says - only the dialogs take the theme, through the theme*
+// properties. These are the same defaults loadOmarchyTheme() starts from.
+void setDefaultHighlighterTheme(MarkdownHighlighter *highlighter, bool dark) {
+    const QColor page(dark ? QStringLiteral("#101010") : QStringLiteral("#ffffff"));
+    const QColor text(dark ? QStringLiteral("#eeeeee") : QStringLiteral("#222324"));
+    highlighter->setTheme(dark, page.name(), text.name(),
+                          dark ? QStringLiteral("#5584aa") : QStringLiteral("#2077b2"),
+                          blend(page, text, 0.06).name());
+}
+
 }
 
