# Vendored from Arch's rofi package:
#   https://gitlab.archlinux.org/archlinux/packaging/packages/rofi
# with five patches. keyboard-on-demand.patch: when ROFI_KEYBOARD_ON_DEMAND is
# set in its environment, rofi asks for on-demand keyboard focus instead of
# exclusive. Stock rofi on Wayland always takes the keyboard exclusively (a
# layer-shell overlay), so nothing else can be typed into or clicked while it
# is open. The launcher (SUPER D) sets the variable: a file opened with
# Shift+Enter in its ФАЙЛЫ tab floats beside rofi, and a click on that window
# gives it the keyboard (seek, speed up a video) while rofi stays open; a click
# on rofi takes it back. Every other rofi menu is unchanged.
#
# num-current-row.patch: a num-current-row widget, the position of the selected
# row among the filtered ones - next to rofi's own num-filtered-rows and
# num-rows the launcher's prompt line reads "2 / 23 / 84721". The widget's text
# carries its own " /", so stock rofi, which draws nothing for it, shows a
# clean "23 / 84721".
#
# blink-interval.patch: a blink-interval theme property, the ms between the
# input cursor's on and off (rofi hard-codes 1200; still the default).
#
# keep-list.patch: a keep-list script-mode option. A script answering an action
# with it (and no rows) keeps the rows on screen - the filter and the selected
# row stay, only the message and other options change. Shift+Enter in ФАЙЛЫ
# toggles the preview with it; before, rofi needed a fresh list to stay open,
# and the row Shift+Enter was pressed on had to move to the top to keep the
# cursor.
#
# quote-entry.patch: -on-selection-changed gets {entry} shell-quoted, as one
# argument. Stock rofi pastes the row in raw and then parses the command line,
# so a row with an odd " or a trailing \ (a file, an app, a window title like
# 27" monitor) failed to parse and rofi's error dialog replaced the menu.
#
# install-scripts/rofi-ondemand.sh builds this with makepkg. pkgrel is above
# the repos' (1, CachyOS 1.1), so `pacman -Syu` keeps it - until the repos ship
# a newer rofi, which replaces it with the stock build: the launcher then works
# as before, without the click-to-focus. To follow, set the new pkgver, the
# sha256 of its release tarball, and re-apply the patches.
#
# Also changed from Arch's copy: the source is the release tarball rather than
# the git tag - it bundles libgwater/libnkutils (no submodules) and ships the
# man pages prebuilt, which a git checkout can only make with pandoc (built
# without it, rofi had no man pages at all). So makedepends drops git and
# pandoc, and check, which only the test suite needs (check() is gone).
#
# Maintainer: Morten Linderud <foxboron@archlinux.org>
# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Maxim Baz <$pkgname at maximbaz dot com>
# Contributor: Anatol Pomozov
# Contributor: Benjamin Chrétien <chretien + aur [at] lirmm [dot] fr>
# Contributor: Eric Engestrom <aur [at] engestrom [dot] ch>
# Contributor: Rasi <rasi@xssn.at>
# Contributor: Sean Pringle <sean.pringle@gmail.com>
# Contributor: SanskritFritz (gmail)

pkgname=rofi
pkgver=2.0.0
pkgrel=5
pkgdesc="A window switcher, application launcher and dmenu replacement (on-demand focus, current-row, blink-interval, keep-list and entry-quoting patches)"
url="https://davatorium.github.io/rofi"
arch=('x86_64')
license=('MIT')
depends=('bash' 'cairo' 'gdk-pixbuf2' 'glib2' 'glibc' 'hicolor-icon-theme' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'pango' 'startup-notification' 'wayland' 'xcb-imdkit' 'xcb-util' 'xcb-util-cursor' 'xcb-util-keysyms' 'xcb-util-wm')
makedepends=('meson' 'wayland-protocols')
provides=('rofi-wayland')
replaces=('rofi-wayland')
source=("https://github.com/davatorium/rofi/releases/download/${pkgver}/rofi-${pkgver}.tar.gz"
        'fix_xfce4-terminal_binary_name.patch'
        'keyboard-on-demand.patch'
        'num-current-row.patch'
        'blink-interval.patch'
        'keep-list.patch'
        'quote-entry.patch')
sha256sums=('f81659b175306ff487e35d88d6b36128e85a793bfb56b64fa22c62eb54c4abd0'
            '0cd6f1360580f49647ceb7d169ab015f4998e778fd750ce3ad2e861f333824e3'
            'b5b459b4334b0e529010539cfaaf35cd5da5a80d40a03bea42126714bd8a1b2c'
            '473d3a4cd6e9469c1e72245e34fd6a637969a6fbc94c70e2ee05624eb6871d40'
            '16a23289dfe7b53cb16e46462dc6e0f28041eb68016e530eadfe85a47d9689db'
            '2e0cdd44c7c465e68fb4b545f29f98b4bf92d6401adc85ac84571bd515fc1ada'
            '492b3edd150a4eb4fee715b4516c57fd5ca42c562992c066d6a05d0f72ce5fa6')

prepare() {
	cd "${pkgname}-${pkgver}"

	# xfce4-terminal.wrapper is a Debian specific script that Arch does not provide
	patch -Np1 -i "${srcdir}/fix_xfce4-terminal_binary_name.patch"
	patch -Np1 -i "${srcdir}/keyboard-on-demand.patch"
	patch -Np1 -i "${srcdir}/num-current-row.patch"
	patch -Np1 -i "${srcdir}/blink-interval.patch"
	patch -Np1 -i "${srcdir}/keep-list.patch"
	patch -Np1 -i "${srcdir}/quote-entry.patch"
}

build() {
	arch-meson "${pkgname}-${pkgver}" build -Dcheck=disabled
	meson compile -C build
}

package() {
	meson install -C build --destdir "${pkgdir}"

	cd "${pkgname}-${pkgver}"
	install -Dm 644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
	install -Dm 755 Examples/*.sh -t "${pkgdir}/usr/share/doc/${pkgname}/examples"
}
