+// A row escaped for a double-quoted "{entry}" in -on-selection-changed: a
+// backslash before \ " $ and `, the characters that mean something inside
+// double quotes (a newline stays as it is). Pasted in raw, a row with an odd "
+// or a trailing \ made the command fail to parse, and the error dialog
+// replaced the menu.
+static char *escape_for_double_quotes(const char *s) {
+  GString *out = g_string_sized_new(s != NULL ? strlen(s) + 8 : 1);
+  for (const char *c = s; c != NULL && *c != '\0'; c++) {
+    if (*c == '\\' || *c == '"' || *c == '$' || *c == '`')
+      g_string_append_c(out, '\\');
+    g_string_append_c(out, *c);
+  }
+  return g_string_free(out, FALSE);
+}
 static void selection_changed_user_callback(unsigned int index,
                                             RofiViewState *state) {
   if (config.on_selection_changed == NULL)
@@ -645,10 +659,12 @@
