+
+    fn reopen(&mut self, drawable: &dyn Drawable) -> Option<Style> {
+        let old = drawable.as_text()?;
+        let mut t = old.clone();
+        // its own buffer: the committed text (kept for undo) shares the old one
+        let buffer = TextBuffer::new(None);
+        buffer.begin_irreversible_action();
+        buffer.set_text(&old.get_text());
+        buffer.end_irreversible_action();
+        buffer.set_enable_undo(true);
+        buffer.place_cursor(&buffer.end_iter());
+        t.text_buffer = buffer;
+        t.editing = true;
+        t.preedit = None;
+        t.im_context = self.im_context.clone();
+        *t.draw_rect.borrow_mut() = true;
+        let style = t.style;
+        self.style = style;
+        self.text = Some(t);
+        self.input_enabled = true;
+        self.reopened = true;
+        Some(style)
+    }
+
+    fn holds_reopened(&self) -> bool {
+        self.reopened && self.text.is_some()
+    }
