+impl TextTool {
+    // An empty text is dropped, but an emptied reopened text is committed
+    // empty so the original goes away (undoably).
+    fn finish_empty(&mut self) -> ToolUpdateResult {
+        let reopened = std::mem::take(&mut self.reopened);
+        let text = self.text.take();
+        self.input_enabled = false;
+        match text {
+            Some(mut t) if reopened => {
+                t.preedit = None;
+                t.editing = false;
+                t.im_context = None;
+                *t.draw_rect.borrow_mut() = false;
+                ToolUpdateResult::Commit(Box::new(t))
+            }
+            _ => ToolUpdateResult::RedrawAndStopPropagation,
+        }
+    }
