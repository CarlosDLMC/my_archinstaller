diff --git a/src/tools/ellipse.rs b/src/tools/ellipse.rs
index 48a3fe9..a4cdb08 100644
--- a/src/tools/ellipse.rs
+++ b/src/tools/ellipse.rs
@@ -24,6 +24,43 @@ pub struct Ellipse {
 }
 
 impl Drawable for Ellipse {
+    fn hit_test(&self, pos: Vec2D) -> bool {
+        let Some(radii) = self.radii else {
+            return false;
+        };
+        let (rx, ry) = (radii.x.abs().max(1.0), radii.y.abs().max(1.0));
+        let tol = self
+            .style
+            .size
+            .to_line_width(self.style.annotation_size_factor)
+            / 2.0
+            + crate::math::GRAB_SLACK;
+        let (dx, dy) = (pos.x - self.middle.x, pos.y - self.middle.y);
+        // 1 on the outline, scaled back to pixels along the smaller radius
+        let d = ((dx / rx).powi(2) + (dy / ry).powi(2)).sqrt();
+        let r = rx.min(ry);
+        if self.style.fill {
+            (d - 1.0) * r <= tol
+        } else {
+            ((d - 1.0) * r).abs() <= tol
+        }
+    }
+
+    fn translate(&mut self, delta: Vec2D) {
+        self.middle += delta;
+        self.origin += delta;
+    }
+
+    fn bounds(&self) -> Option<(Vec2D, Vec2D)> {
+        let r = self.radii?;
+        let r = Vec2D::new(r.x.abs(), r.y.abs());
+        let w = self
+            .style
+            .size
+            .to_line_width(self.style.annotation_size_factor);
+        crate::math::bounds_of(&[self.middle - r, self.middle + r], w)
+    }
+
     fn draw(
         &self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
diff --git a/src/tools/highlight.rs b/src/tools/highlight.rs
index 6bbbd8f..4a62939 100644
--- a/src/tools/highlight.rs
+++ b/src/tools/highlight.rs
@@ -160,7 +160,60 @@ pub struct HighlightTool {
     sender: Option<Sender<SketchBoardInput>>,
 }
 
+impl Highlighter<FreehandHighlight> {
+    fn absolute_points(&self) -> Vec<Vec2D> {
+        let Some(first) = self.data.points.first() else {
+            return Vec::new();
+        };
+        std::iter::once(*first)
+            .chain(self.data.points.iter().skip(1).map(|p| *first + *p))
+            .collect()
+    }
+
+    fn half_width(&self) -> f32 {
+        self.style
+            .size
+            .to_highlight_width(self.style.annotation_size_factor)
+            / 2.0
+    }
+}
+
 impl Drawable for HighlightKind {
+    fn hit_test(&self, pos: Vec2D) -> bool {
+        match self {
+            HighlightKind::Block(h) => h.data.size.is_some_and(|size| {
+                math::rect_hit(pos, h.data.top_left, size, math::GRAB_SLACK, true)
+            }),
+            HighlightKind::Freehand(h) => {
+                math::near_polyline(pos, &h.absolute_points(), h.half_width() + math::GRAB_SLACK)
+            }
+        }
+    }
+
+    fn translate(&mut self, delta: Vec2D) {
+        match self {
+            HighlightKind::Block(h) => {
+                h.data.top_left += delta;
+                h.data.origin += delta;
+            }
+            HighlightKind::Freehand(h) => {
+                if let Some(first) = h.data.points.first_mut() {
+                    *first += delta;
+                }
+            }
+        }
+    }
+
+    fn bounds(&self) -> Option<(Vec2D, Vec2D)> {
+        match self {
+            HighlightKind::Block(h) => {
+                let size = h.data.size?;
+                math::bounds_of(&[h.data.top_left, h.data.top_left + size], 0.0)
+            }
+            HighlightKind::Freehand(h) => math::bounds_of(&h.absolute_points(), h.half_width()),
+        }
+    }
+
     fn draw(
         &self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
