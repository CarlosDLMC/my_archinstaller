diff --git a/src/math.rs b/src/math.rs
index 3a31363..1becd23 100644
--- a/src/math.rs
+++ b/src/math.rs
@@ -214,3 +214,54 @@ pub fn rect_round(rect: (Vec2D, Vec2D)) -> (Vec2D, Vec2D) {
 
     (pos, size)
 }
+
+// How far (image pixels) a press may miss a drawing and still pick it up.
+pub const GRAB_SLACK: f32 = 6.0;
+
+pub fn distance_to_segment(p: Vec2D, a: Vec2D, b: Vec2D) -> f32 {
+    let ab = b - a;
+    let len2 = ab.norm2();
+    if len2 == 0.0 {
+        return p.distance_to(&a);
+    }
+    let t = (((p.x - a.x) * ab.x + (p.y - a.y) * ab.y) / len2).clamp(0.0, 1.0);
+    p.distance_to(&(a + ab * t))
+}
+
+// Whether `p` is within `tol` of the line through `points`.
+pub fn near_polyline(p: Vec2D, points: &[Vec2D], tol: f32) -> bool {
+    match points {
+        [] => false,
+        [only] => p.distance_to(only) <= tol,
+        _ => points
+            .windows(2)
+            .any(|w| distance_to_segment(p, w[0], w[1]) <= tol),
+    }
+}
+
+// Whether `p` is on a rectangle: anywhere inside when filled, else within
+// `tol` of its border.
+pub fn rect_hit(p: Vec2D, top_left: Vec2D, size: Vec2D, tol: f32, filled: bool) -> bool {
+    let (tl, size) = rect_ensure_positive_size(top_left, size);
+    let br = tl + size;
+    let inside = |m: f32| p.x >= tl.x - m && p.x <= br.x + m && p.y >= tl.y - m && p.y <= br.y + m;
+    if filled {
+        inside(tol)
+    } else {
+        inside(tol) && !(size.x > 2.0 * tol && size.y > 2.0 * tol && inside(-tol))
+    }
+}
+
+// (top left, bottom right) of some points, grown by `margin`.
+pub fn bounds_of(points: &[Vec2D], margin: f32) -> Option<(Vec2D, Vec2D)> {
+    let first = points.first()?;
+    let (mut min, mut max) = (*first, *first);
+    for p in points {
+        min = Vec2D::new(min.x.min(p.x), min.y.min(p.y));
+        max = Vec2D::new(max.x.max(p.x), max.y.max(p.y));
+    }
+    Some((
+        min - Vec2D::new(margin, margin),
+        max + Vec2D::new(margin, margin),
+    ))
+}
