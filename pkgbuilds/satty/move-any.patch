diff --git a/src/tools/arrow.rs b/src/tools/arrow.rs
index c09a2e8..5a4fa00 100644
--- a/src/tools/arrow.rs
+++ b/src/tools/arrow.rs
@@ -136,7 +136,40 @@ impl Tool for ArrowTool {
     }
 }
 
+impl Arrow {
+    // half the widest part (tail or head) plus slack
+    fn grab_reach(&self) -> f32 {
+        let f = self.style.annotation_size_factor;
+        let s = self.style.size;
+        s.to_line_width(f)
+            .max(s.to_arrow_tail_width(f))
+            .max(s.to_arrow_head_length(f) * 0.6)
+            / 2.0
+            + crate::math::GRAB_SLACK
+    }
+}
+
 impl Drawable for Arrow {
+    fn hit_test(&self, pos: Vec2D) -> bool {
+        let Some(end) = self.end else {
+            return false;
+        };
+        let f = self.style.annotation_size_factor;
+        crate::math::distance_to_segment(pos, self.start, end) <= self.grab_reach()
+            || pos.distance_to(&end) <= self.style.size.to_arrow_head_length(f) * 0.7
+    }
+
+    fn translate(&mut self, delta: Vec2D) {
+        self.start += delta;
+        if let Some(e) = &mut self.end {
+            *e += delta;
+        }
+    }
+
+    fn bounds(&self) -> Option<(Vec2D, Vec2D)> {
+        crate::math::bounds_of(&[self.start, self.end?], self.grab_reach())
+    }
+
     fn draw(
         &self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
