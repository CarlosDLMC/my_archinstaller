+impl Marker {
+    // about the drawn circle: "77" is ~1.1 font sizes wide
+    fn grab_radius(&self) -> f32 {
+        let font = self
+            .style
+            .size
+            .to_text_size(self.style.annotation_size_factor) as f32;
+        font * 0.6 + self.get_line_width() * 2.5
+    }
+}
+
 impl Drawable for Marker {
+    fn hit_test(&self, pos: Vec2D) -> bool {
+        pos.distance_to(&self.pos) <= self.grab_radius() + crate::math::GRAB_SLACK
+    }
+
+    fn translate(&mut self, delta: Vec2D) {
+        self.pos += delta;
+    }
+
+    fn bounds(&self) -> Option<(Vec2D, Vec2D)> {
+        crate::math::bounds_of(&[self.pos], self.grab_radius())
+    }
+
     fn draw(
         &self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
