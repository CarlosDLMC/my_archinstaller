+// A committed text being dragged: its index among the drawables and how far
+// it has been moved so far.
+struct GrabbedDrawable {
+    index: usize,
+    moved: Vec2D,
+}
+
 pub struct SketchBoard {
+    grabbed: Option<GrabbedDrawable>,
     renderer: FemtoVGArea,
     active_tool: Rc<RefCell<dyn Tool>>,
     tool_edit_mode: bool,
@@ -749,6 +757,65 @@ impl SketchBoard {
         }
     }
 
+    // With the pointer or the text tool, a press on a committed text picks
+    // it up and dragging moves it (one undo step). The text being typed
+    // keeps its own clicks (cursor, selection); it is committed first when
+    // another text is picked up.
+    fn handle_grab(&mut self, ie: &InputEvent) -> Option<ToolUpdateResult> {
+        let InputEvent::Mouse(me) = ie else {
+            return None;
+        };
+        if me.button != MouseButton::Primary {
+            return None;
+        }
+        match me.type_ {
+            MouseEventType::Click | MouseEventType::BeginDrag => {
+                // the press arrives from both the click and the drag gesture
+                if self.grabbed.is_some() {
+                    return Some(ToolUpdateResult::StopPropagation);
+                }
+                if !matches!(self.active_tool_type(), Tools::Pointer | Tools::Text) {
+                    return None;
+                }
+                if self
+                    .active_tool
+                    .borrow()
+                    .get_drawable()
+                    .is_some_and(|d| d.hit_test(me.pos))
+                {
+                    return None;
+                }
+                let index = self.renderer.movable_at(me.pos)?;
+                self.deactivate_active_tool();
+                self.renderer.set_grabbed(index, true);
+                self.grabbed = Some(GrabbedDrawable {
+                    index,
+                    moved: Vec2D::zero(),
+                });
+                Some(ToolUpdateResult::Redraw)
+            }
+            MouseEventType::UpdateDrag | MouseEventType::EndDrag => {
+                let g = self.grabbed.as_mut()?;
+                // drag positions are relative to where it started
+                let step = me.pos - g.moved;
+                g.moved = me.pos;
+                let (index, moved) = (g.index, g.moved);
+                self.renderer.move_drawable(index, step);
+                if me.type_ == MouseEventType::EndDrag {
+                    self.renderer.set_grabbed(index, false);
+                    self.renderer.commit_move(index, moved);
+                    self.grabbed = None;
+                }
+                Some(ToolUpdateResult::Redraw)
+            }
+            MouseEventType::Release => self
+                .grabbed
+                .as_ref()
+                .map(|_| ToolUpdateResult::StopPropagation),
+            _ => None,
+        }
+    }
+
     fn handle_rotate(&mut self, clockwise: bool) -> ToolUpdateResult {
         // commit a drawing in progress so it is rotated with the image
         self.deactivate_active_tool();
@@ -1248,21 +1315,25 @@ impl Component for SketchBoard {
