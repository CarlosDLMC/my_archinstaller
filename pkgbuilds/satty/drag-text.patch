diff --git a/src/tools/text.rs b/src/tools/text.rs
index 07208e9..3246b50 100644
--- a/src/tools/text.rs
+++ b/src/tools/text.rs
@@ -224,6 +224,25 @@ impl Text {
 }
 
 impl Drawable for Text {
+    fn hit_test(&self, pos: Vec2D) -> bool {
+        // a few pixels of slack around thin text
+        const SLACK: f32 = 4.0;
+        let r = self.rect.borrow();
+        r.width() > 0
+            && pos.x >= r.x() as f32 - SLACK
+            && pos.x <= (r.x() + r.width()) as f32 + SLACK
+            && pos.y >= r.y() as f32 - SLACK
+            && pos.y <= (r.y() + r.height()) as f32 + SLACK
+    }
+
+    fn translate(&mut self, delta: Vec2D) {
+        self.pos += delta;
+    }
+
+    fn set_grabbed(&self, grabbed: bool) {
+        *self.draw_rect.borrow_mut() = grabbed;
+    }
+
     fn draw(
         &self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
