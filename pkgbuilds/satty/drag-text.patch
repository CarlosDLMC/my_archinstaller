+    // The topmost committed drawable that can be dragged and is under `pos`.
+    pub fn movable_at(&self, pos: Vec2D) -> Option<usize> {
+        self.drawables.iter().rposition(|d| d.hit_test(pos))
+    }
+
+    pub fn move_drawable(&mut self, index: usize, delta: Vec2D) {
+        if let Some(d) = self.drawables.get_mut(index) {
+            d.translate(delta);
+        }
+    }
+
+    pub fn set_grabbed(&self, index: usize, grabbed: bool) {
+        if let Some(d) = self.drawables.get(index) {
+            d.set_grabbed(grabbed);
+        }
+    }
+
+    // A finished drag goes on the undo stack.
+    pub fn commit_move(&mut self, index: usize, delta: Vec2D) {
+        if delta.is_zero() || index >= self.drawables.len() {
+            return;
+        }
+        self.undo_stack.push(HistoryEntry::Move { index, delta });
+        self.redo_stack.clear();
+    }
+
     pub fn request_rotation(&mut self, clockwise: bool) {
         self.pending_rotations.push(clockwise);
     }
