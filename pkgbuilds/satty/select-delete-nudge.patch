                 self.drawables_moved();
@@ -443,6 +465,7 @@ impl FemtoVgAreaMut {
     }
 
     pub fn redo(&mut self) -> bool {
+        self.selected = None;
         match self.redo_stack.pop() {
             Some(HistoryEntry::Drawable(mut drawable)) => {
                 drawable.handle_redo();
@@ -471,6 +494,15 @@ impl FemtoVgAreaMut {
                 self.undo_stack.push(entry);
                 true
             }
+            Some(HistoryEntry::Remove { index, mut drawable }) => {
+                if index < self.drawables.len() {
+                    self.drawables.remove(index);
