+            }
             Some(HistoryEntry::Move { index, delta }) => {
                 self.move_drawable(index, delta);
                 self.drawables_moved();
@@ -482,6 +514,7 @@ impl FemtoVgAreaMut {
     }
 
     pub fn clear_all(&mut self) -> bool {
+        self.selected = None;
         if self.drawables.is_empty() {
             return false;
         }
@@ -581,6 +614,50 @@ impl FemtoVgAreaMut {
         self.grabbed = index;
     }
 
+    pub fn set_selected(&mut self, index: Option<usize>) {
+        self.selected = index.filter(|i| *i < self.drawables.len());
+    }
+
+    // Move the selected drawable by `delta` (arrow keys). Presses in a row on
+    // the same drawable are one undo step. False when none is selected.
+    pub fn nudge_selected(&mut self, delta: Vec2D) -> bool {
+        let Some(index) = self.selected else {
+            return false;
+        };
+        if index >= self.drawables.len() || self.editing.is_some() {
+            return false;
+        }
+        self.move_drawable(index, delta);
+        self.drawables_moved();
+        match self.undo_stack.last_mut() {
+            Some(HistoryEntry::Move { index: i, delta: d }) if *i == index => {
+                *d = *d + delta;
+            }
+            _ => self.undo_stack.push(HistoryEntry::Move { index, delta }),
+        }
+        self.redo_stack.clear();
+        true
+    }
+
+    pub fn has_selected(&self) -> bool {
+        self.selected.is_some()
+    }
+
+    // Delete the drawable last picked up (one undo step). False when none is.
+    pub fn remove_selected(&mut self) -> bool {
+        let Some(index) = self.selected.take() else {
+            return false;
+        };
+        if index >= self.drawables.len() || self.editing.is_some() {
+            return false;
+        }
+        let drawable = self.drawables.remove(index);
+        self.undo_stack.push(HistoryEntry::Remove { index, drawable });
+        self.redo_stack.clear();
+        self.drawables_moved();
+        true
+    }
+
     // A finished drag goes on the undo stack.
     pub fn commit_move(&mut self, index: usize, delta: Vec2D) {
         if delta.is_zero() || index >= self.drawables.len() {
@@ -817,6 +894,7 @@ impl FemtoVgAreaMut {
         if render_crop
