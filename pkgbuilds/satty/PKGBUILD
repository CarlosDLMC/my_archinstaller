# Vendored from Arch's satty package:
#   https://gitlab.archlinux.org/archlinux/packaging/packages/satty
# with our patches, one per change. ScreenShot.sh opens every screenshot in
# satty to draw on it.
#
# rotate.patch: two toolbar buttons (and Ctrl-R / Ctrl-Shift-R) turn the image a
# quarter right or left. What is drawn so far is baked into the image and turns
# with it; the view refits, the size label and a crop follow. Undo/redo bring
# back the image and its drawings as they were.
#
# install-scripts/satty-patched.sh builds this with makepkg and puts satty in
# IgnorePkg. pkgrel is above the repos' (Arch 1, CachyOS 1.1) as well. To follow
# a new satty, set pkgver and the tarball's sha256 and re-apply the patches
# (the dev tree is a clone of github.com/gabm/satty with one commit per patch on
# the release tag; `git format-patch` them back here).
#
# Also changed from Arch's copy: the source is the tag's tarball rather than a
# git checkout (makedepends drops git).
#
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=satty
pkgver=0.22.0
pkgrel=2
pkgdesc="Modern screenshot annotation tool, inspired by Swappy and Flameshot (rotate patch)"
arch=(x86_64)
url="https://github.com/gabm/satty"
license=(MPL-2.0)
depends=(
  fontconfig
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
  libgcc
  pango
)
makedepends=(cargo)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/gabm/satty/archive/refs/tags/v${pkgver}.tar.gz"
        'rotate.patch')
sha256sums=('eee18b5f9eabf164da69c7e6e916c98afb78dd296d83e28bb96d9f9636a5fe36'
            '47c1a0e22c387ab3f3c4c1dc658fcbae910b9a43993494206c2a90647911f64d')

_srcname="Satty-${pkgver}"

prepare() {
  cd "$_srcname"
  patch -Np1 -i "${srcdir}/rotate.patch"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_srcname"
  # In the source tree, not a CARGO_TARGET_DIR set by the builder's
  # environment: package() reads target/release.
  CARGO_TARGET_DIR=target cargo build --frozen --release --all-features
}

package() {
  cd "$_srcname"
  install -vDm755 -t "$pkgdir/usr/bin" target/release/satty

  install -vDm644 completions/_satty \
    "$pkgdir/usr/share/zsh/site-functions/_satty"
  install -vDm644 completions/satty.bash \
    "$pkgdir/usr/share/bash-completion/completions/satty"
  install -vDm644 completions/satty.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/satty.fish"
  install -vDm644 completions/satty.nu \
    "$pkgdir/usr/share/nushell/completions/satty.nu"
  install -vDm644 completions/satty.elv \
    "$pkgdir/usr/share/elvish/lib/satty.elv"

  install -vDm644 -t "$pkgdir/usr/share/applications" satty.desktop
  install -vDm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" assets/satty.svg

  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  cp -va -t "$pkgdir/usr/share/doc/$pkgname" assets
}
