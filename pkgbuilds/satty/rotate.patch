+
+    // Follow a quarter turn of an image that was `w` x `h` before it.
+    pub fn rotate(&mut self, clockwise: bool, w: f32, h: f32) {
+        if let Some(c) = &mut self.crop {
+            let (pos, size) = c.get_rectangle();
+            c.pos = if clockwise {
+                Vec2D::new(h - (pos.y + size.y), pos.x)
+            } else {
+                Vec2D::new(pos.y, w - (pos.x + size.x))
+            };
+            c.size = Vec2D::new(size.y, size.x);
+        }
+        self.action = None;
+    }
 }
 
