+    pub fn request_rotation(&mut self, clockwise: bool) {
+        self.pending_rotations.push(clockwise);
+    }
+
+    fn image_size(&self) -> (f32, f32) {
+        (
+            self.background_image.width() as f32,
+            self.background_image.height() as f32,
+        )
+    }
+
+    // Put `background` and `drawables` in place of the current ones and
+    // return the current ones as the history entry that swaps them back.
+    fn swap_image(
+        &mut self,
+        clockwise: bool,
+        background: Pixbuf,
+        drawables: Vec<Box<dyn Drawable>>,
+    ) -> HistoryEntry {
+        let background = std::mem::replace(&mut self.background_image, background);
+        let drawables = std::mem::replace(&mut self.drawables, drawables);
+        if let Some(id) = self.background_image_id.take() {
+            self.stale_images.push(id);
+        }
+        self.size_changed = true;
+        HistoryEntry::Rotate {
+            clockwise,
+            background,
+            drawables,
+        }
+    }
+
+    // Bake the annotations into the image and turn it a quarter. The old
+    // image and annotations go on the undo stack.
+    fn rotate(
+        &mut self,
+        canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
+        font: FontId,
+        clockwise: bool,
+    ) -> Result<()> {
+        let (w, h) = self.image_size();
+        let baked = self.render_region(canvas, font, Vec2D::zero(), Vec2D::new(w, h))?;
+        let rotated = SketchBoard::image_to_pixbuf(baked)
+            .rotate_simple(if clockwise {
+                PixbufRotation::Clockwise
+            } else {
+                PixbufRotation::Counterclockwise
+            })
+            .ok_or_else(|| anyhow::anyhow!("could not rotate the image"))?;
+        let entry = self.swap_image(clockwise, rotated, Vec::new());
+        self.undo_stack.push(entry);
+        self.redo_stack.clear();
+        self.crop_tool.borrow_mut().rotate(clockwise, w, h);
+        Ok(())
+    }
+
+    // Run the requested rotations, free replaced images and refit the view
+    // when the image changed size. Returns the new image size and crop size.
+    #[allow(clippy::type_complexity)]
+    pub fn apply_rotations(
+        &mut self,
+        canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
+        font: FontId,
+    ) -> Result<Option<((i32, i32), Option<(i32, i32)>)>> {
+        let mut result = Ok(());
+        for clockwise in std::mem::take(&mut self.pending_rotations) {
+            result = self.rotate(canvas, font, clockwise);
+            if result.is_err() {
+                break;
+            }
+        }
+        for id in self.stale_images.drain(..) {
+            canvas.delete_image(id);
+        }
+        result?;
+        if !std::mem::take(&mut self.size_changed) {
+            return Ok(None);
+        }
+        // fit the new image to the window, centred
+        self.is_drag = false;
+        self.zoom_scale = 0.0;
+        self.last_scale = 0.0;
+        self.reset_drag_offset();
+        self.update_transformation(canvas);
+
+        let (w, h) = self.image_size();
+        let crop = self.crop_tool.borrow().get_crop().map(|c| {
+            let (_, size) = c.get_rectangle();
+            (size.x.round() as i32, size.y.round() as i32)
+        });
+        Ok(Some(((w as i32, h as i32), crop)))
+    }
+
     pub fn render_native_resolution(
         &mut self,
         canvas: &mut femtovg::Canvas<femtovg::renderer::OpenGl>,
@@ -433,6 +590,18 @@ impl FemtoVgAreaMut {
