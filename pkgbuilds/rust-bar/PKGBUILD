# The desktop bar, built from this repo's rust-bar/ crate. Not a download:
# install-scripts/rust-bar.sh packs rust-bar/ into rust-bar.tar.gz next to this
# file and runs makepkg in a temp dir, so the package is always the crate as it
# stands in the checkout. RUST_BAR_SOURCE (that script's hash of the crate)
# lands in /usr/share/rust-bar/source; the script compares it on the next run
# and builds again only when the crate changed.
#
# The bar is Wayland + Vulkan (wgpu): one of the Mesa Vulkan drivers that
# graphics.sh installs, or the NVIDIA one. rust-bar.sh adds Mesa's software
# Vulkan (lavapipe) where there is none, as in a virtual machine.

pkgname=rust-bar
pkgver=0.1.0
pkgrel=1
pkgdesc='The desktop bar, in Rust: the quickshell bar with less memory'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug' '!lto')
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'libpipewire'
  'libxkbcommon'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=(
  'cargo'
  'clang'     # bindgen, for the pipewire bindings
  'pkgconf'
)
source=('rust-bar.tar.gz')
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/rust-bar"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/rust-bar"
  export CARGO_HOME="$srcdir/cargo-home"
  # Inside srcdir: the builder's own CARGO_TARGET_DIR must not catch it.
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/rust-bar" "$pkgdir/usr/bin/rust-bar"
  install -dm755 "$pkgdir/usr/share/rust-bar"
  printf '%s\n' "${RUST_BAR_SOURCE:-unknown}" > "$pkgdir/usr/share/rust-bar/source"
  install -Dm644 "$srcdir/rust-bar/README.md" "$pkgdir/usr/share/doc/rust-bar/README.md"
}
