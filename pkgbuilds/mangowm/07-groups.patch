 		tc = c->group_prev;
+		if (!tc && config.group_focus_wrap)
+			tc = client_group_tail(c);
 	}
 
-	if (!tc)
+	if (!tc || tc == c)
 		return 0;
 
 	client_focus_group_member(tc);
