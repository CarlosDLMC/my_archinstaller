From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CarlosDLMC <delamorenacoco.carlos@gmail.com>
Date: Thu, 22 Oct 2026 08:20:59 +0200
Subject: [PATCH 09/12] animation: closing windows can fade out under the top
 layer

fadeout_below_top=1 stacks the fade-out layer right below the top layer
(below the special workspace's top layer while it is shown), so a closing
window no longer draws over the bar, launchers or notifications for the
length of its close animation; Hyprland draws a closing window in its own
layer.
---
 include/mango/config/parse.h   |  1 +
 include/mango/manage/monitor.h |  1 +
 src/config/option_defs.c       |  4 ++++
 src/config/reapply.c           |  1 +
 src/main.c                     |  1 +
 src/manage/monitor.c           | 21 +++++++++++++++++++++
 6 files changed, 29 insertions(+)

diff --git a/include/mango/config/parse.h b/include/mango/config/parse.h
index 5565ea48..a88a8b3f 100644
--- a/include/mango/config/parse.h
+++ b/include/mango/config/parse.h
@@ -320,6 +320,7 @@ typedef struct {
 	int32_t group_keep_single;
 	int32_t group_auto_join;
 	int32_t group_focus_wrap;
+	int32_t fadeout_below_top;
 	int32_t animation_fade_out;
 	int32_t tag_animation_direction;
 	float zoom_initial_ratio;
diff --git a/include/mango/manage/monitor.h b/include/mango/manage/monitor.h
index 0e976d23..44a02f29 100644
--- a/include/mango/manage/monitor.h
+++ b/include/mango/manage/monitor.h
@@ -123,6 +123,7 @@ bool is_centertile_layout(Monitor *m);
 bool is_overcircle_mode(const Monitor *m);
 void special_update_dim(Monitor *m);
 void special_sync_top_layer(bool special_active);
+void fadeout_layer_sync(void);
 uint32_t get_tag_status(uint32_t tag, Monitor *m);
 uint32_t get_tags_first_tag_num(uint32_t source_tags);
 uint32_t get_tags_first_tag(uint32_t source_tags);
