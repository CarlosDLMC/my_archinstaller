@@ -1112,6 +1118,9 @@ void mango_bar_decoration_apply_config(MangoBarDecoration *node,
 	g_free(node->font_desc);
 	node->font_desc =
 		g_strdup(data->font_desc ? data->font_desc : "monospace Bold 13");
