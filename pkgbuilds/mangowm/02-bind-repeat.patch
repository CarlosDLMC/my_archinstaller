From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CarlosDLMC <delamorenacoco.carlos@gmail.com>
Date: Thu, 22 Oct 2026 08:04:52 +0200
Subject: [PATCH 02/12] input: only binde binds repeat
 (bind_repeat_flagged_only)

New bind flag e (binde, TOML flag "repeat"): the bind runs again while its
key is held. With bind_repeat_flagged_only=1 the other binds run once per
press, as Hyprland's bind; their repeats are still swallowed.
---
 include/mango/common/server.h | 1 +
 include/mango/config/parse.h  | 2 ++
 src/config/binding_parse.c    | 3 +++
 src/config/option_defs.c      | 7 ++++++-
 src/config/toml_parse.c       | 2 ++
 src/input/keyboard.c          | 9 +++++++++
 6 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/include/mango/common/server.h b/include/mango/common/server.h
index 2445589a..007d43ae 100644
--- a/include/mango/common/server.h
+++ b/include/mango/common/server.h
@@ -179,6 +179,7 @@ struct MangoServer {
 	int active_capture_count;
 	bool cli_debug_log;
 	uint32_t last_hold_keycode;
+	bool key_repeating; /* keyboard_repeat is running the held key's binds */
 	uint32_t tagmask; /* default 9 tags; updated with config.tag_num */
 	uint32_t next_client_id;
 
diff --git a/include/mango/config/parse.h b/include/mango/config/parse.h
index 2d41d3f4..4978de5b 100644
--- a/include/mango/config/parse.h
+++ b/include/mango/config/parse.h
@@ -101,6 +101,7 @@ typedef struct {
 	bool isreleaseapply;
 	bool ispassapply;
 	bool isallowconflict;
+	bool isrepeatapply; /* binde: runs again while its key is held */
 	int line_number;
 	int file_index;
 } KeyBinding;
@@ -314,6 +315,7 @@ typedef struct {
 	int32_t layer_animation_type_close;
 	int32_t animation_fade_in;
 	int32_t animation_native_content;
+	int32_t bind_repeat_flagged_only;
 	int32_t animation_fade_out;
 	int32_t tag_animation_direction;
 	float zoom_initial_ratio;
diff --git a/src/config/binding_parse.c b/src/config/binding_parse.c
index ed3c9bea..58b47323 100644
--- a/src/config/binding_parse.c
+++ b/src/config/binding_parse.c
@@ -83,6 +83,9 @@ void parse_bind_flags(const char *str, KeyBinding *kb) {
 		case 'c':
 			kb->isallowconflict = true;
 			break;
+		case 'e':
+			kb->isrepeatapply = true;
+			break;
 		default:
 			mango_error(false, WLR_ERROR,
 						"Unknown bind flag: \033[1m\033[31m%c\033[0m\n",
diff --git a/src/config/option_defs.c b/src/config/option_defs.c
index 113a642c..035d2a67 100644
--- a/src/config/option_defs.c
+++ b/src/config/option_defs.c
@@ -71,6 +71,8 @@ bool parse_option(Config *config, char *key, char *value, int line_number) {
 		config->animation_fade_in = atoi(value);
 	} else if (strcmp(key, "animation_native_content") == 0) {
 		config->animation_native_content = atoi(value);
+	} else if (strcmp(key, "bind_repeat_flagged_only") == 0) {
+		config->bind_repeat_flagged_only = atoi(value);
 	} else if (strcmp(key, "animation_fade_out") == 0) {
 		config->animation_fade_out = atoi(value);
 	} else if (strcmp(key, "tag_animation_direction") == 0) {
@@ -1929,7 +1931,7 @@ bool parse_option(Config *config, char *key, char *value, int line_number) {
 
 		config->exec_once_count++;
 
-	} else if (regex_match("^bind[s|l|r|p|c]*$", key)) {
+	} else if (regex_match("^bind[s|l|r|p|c|e]*$", key)) {
 		config->key_bindings =
 			realloc(config->key_bindings,
 					(config->key_bindings_count + 1) * sizeof(KeyBinding));
@@ -2382,6 +2384,7 @@ void set_value_default() {
 	config.layer_animation_type_close = ANIM_TYPE_UNSET;
 	config.animation_fade_in = 1;
 	config.animation_native_content = 0;
+	config.bind_repeat_flagged_only = 0;
 	config.animation_fade_out = 1;
 	config.tag_animation_direction = HORIZONTAL;
 	config.zoom_initial_ratio = 0.4f;
@@ -2732,6 +2735,8 @@ void override_config(void) {
 	config.animation_fade_in = CLAMP_INT(config.animation_fade_in, 0, 1);
 	config.animation_native_content =
 		CLAMP_INT(config.animation_native_content, 0, 1);
+	config.bind_repeat_flagged_only =
+		CLAMP_INT(config.bind_repeat_flagged_only, 0, 1);
 	config.animation_fade_out = CLAMP_INT(config.animation_fade_out, 0, 1);
 	config.zoom_initial_ratio =
 		CLAMP_FLOAT(config.zoom_initial_ratio, 0.1f, 1.0f);
diff --git a/src/config/toml_parse.c b/src/config/toml_parse.c
index 22abee12..e24e52db 100644
--- a/src/config/toml_parse.c
+++ b/src/config/toml_parse.c
@@ -309,6 +309,8 @@ static int toml_bind_flag_char(const char *word) {
 		return 'p';
 	if (strcmp(word, "conflict") == 0)
 		return 'c';
+	if (strcmp(word, "repeat") == 0)
+		return 'e';
 	return 0;
 }
 
diff --git a/src/input/keyboard.c b/src/input/keyboard.c
index 344bc258..7d1f380c 100644
--- a/src/input/keyboard.c
+++ b/src/input/keyboard.c
@@ -188,10 +188,12 @@ int32_t keyboard_repeat(void *data) {
 	wl_event_source_timer_update(group->key_repeat_source,
 								 1000 / group->keyboard->repeat_info.rate);
 
+	server.key_repeating = true;
 	for (i = 0; i < group->nsyms; i++)
 		keyboard_check_keybinding(WL_KEYBOARD_KEY_STATE_PRESSED, false,
 								  group->mods, group->keysyms[i],
 								  group->keycode);
+	server.key_repeating = false;
 
 	return 0;
 }
@@ -642,6 +644,13 @@ int32_t keyboard_check_keybinding(uint32_t state, bool is_locked, uint32_t mods,
 				handled = 0;
 			}
 
+			/* bind_repeat_flagged_only: a held key runs its bind once, as
+			 * Hyprland's bind; only binde repeats. The repeat is still
+			 * swallowed, so it does not reach the focused window. */
+			if (server.key_repeating && config.bind_repeat_flagged_only &&
+				!k->isrepeatapply)
+				break;
+
 			if (k->func(&k->arg))
 				break;
 
