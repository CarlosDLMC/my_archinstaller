# Vendored from Arch's mangowm package:
#   https://gitlab.archlinux.org/archlinux/packaging/packages/mangowm
# built from our fork of mango, https://github.com/CarlosDLMC/mango (branch
# patched: mango 0.18.5 plus sixteen commits, one per change below, that make
# mango look and behave like the Hyprland setup this desktop came from). Every
# one is an option (or a new dispatcher) that is off by default - stock
# behaviour stays until the config turns it on; the config in
# dotfiles/config/mango/ turns them all on.
#
# 01 native-content: a window that moves or resizes keeps its content at its
#    native size, cropped or with its edge pixels extended, as Hyprland draws
#    it (animation_native_content). Stock mango stretched the new, smaller
#    frame of a window shrinking beside a new one: it seemed to grow, then
#    shrink back. Opening windows scale into place (Hyprland's popin).
# 02 bind-repeat: only binde binds repeat while held (bind_repeat_flagged_only).
# 03 keep-layout: reloads and setoption keep the keyboard layout (EN/ES/RU) -
#    every wallpaper change used to reset it - and setoption runs no exec lines.
# 04 layer-fade: layer surfaces (rofi, notifications) fade with their own
#    timing and curves, as Hyprland's fadeLayersIn/Out.
# 05 shadow-colours: focused and unfocused shadow colours; a reload recolours
#    borders and shadows at once (the wallust colours of a new wallpaper).
# 06 fullscreen-takeover: a new window takes over a fullscreen one
#    (misc:on_focus_under_fullscreen 1); hide_cursor dispatcher.
# 07 groups: SUPER+G on a lone window makes a group of one, new windows join
#    the focused group after the current tab, tab focus wraps; grouptoggle and
#    groupmove dispatchers (togglegroup, movegroupwindow).
# 08 group-bar: gaps between tabs, a medium font for the focused tab only.
# 09 fadeout-below-top: closing windows fade out under the bar and launchers.
# 10 special-slide: the special workspace slides in from the right, fading.
# 11 zoom: desktop zoom around the cursor (zoom_by, SUPER+ALT+wheel).
# 12 border-fade: the border colour fades on its own timing (539 ms) while a
#    terminal's opacity fades on the focus one (300 ms), as Hyprland's border
#    and fadeSwitch.
# 13 group-bar-slide: the tabs slide out with their window on a workspace
#    switch (they vanished at its first frame).
# 14 group-switch-fade: switching tabs crossfades (Hyprland's fadeSwitch).
# 15 group-bar-clip: the tabs keep their places on the window and are clipped
#    at the monitor edge, so they slide rigidly with it.
# 16 activation: an app raising itself from a clicked notification comes
#    forward (activation_unfocused_tokens): mango answers xdg-activation itself
#    and honours a token with a real input serial even when its window has no
#    focus, as Hyprland does; a hidden group tab gets its workspace shown and
#    its tab brought forward.
#
# Then fixes, one commit each and no option, from a review of the whole code
# (2026-11): no crash when a window's title bar is a subsurface above its top
# edge (native content asked scenefx for a negative box and mango aborted),
# nor on SUPER+Tab or at the end of a drag with every output off; a refused
# window capture answers with an inert source; setoption no longer leaks;
# a reload keeps the cursor a client has set and the keymap when its xkb names
# did not change, and a config file written while a reload runs is reloaded
# too; a mouse move or floating resize follows the pointer once per frame (a
# resize ends exactly under it); no repeat configure for a size already asked
# for; the IPC status goes out once per event loop pass and not when nothing
# changed, the same title set again does nothing, and tab titles are cut by
# bisection and redrawn only when the cut moves; a window that auto-joins a
# group no longer halves the tab it joins, and the special workspace's border
# and shadow fade with it.
#
# install-scripts/mango-patched.sh builds this with makepkg and puts mangowm
# in pacman's IgnorePkg: a stock mango from the repos would not know the
# options and binds the config uses. depends names the scenefx and wlroots
# libraries by soname, so pacman refuses a library update this build would not
# survive instead of leaving a mango that cannot start; rebuild it then. To
# follow a new mango, rebase the fork's patched branch onto the new upstream tag,
# push a new tag <version>-patched.<pkgrel>, then set pkgver, pkgrel and the
# tarball's sha256 here.
#
# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Matt Quintanilla <matt @ matt quintanilla .xyz>

pkgname=mangowm
_pkgname=mango
pkgver=0.18.5
pkgrel=2
_tag="${pkgver}-patched.${pkgrel}"
pkgdesc="Lightweight, feature rich modern wayland compositor (patched to match a Hyprland setup)"
url="https://mangowm.github.io"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'wayland-protocols' 'pango' 'wayland' 'libinput' 'libdrm' 'cairo'
         'pixman' 'libdisplay-info' 'libliftoff' 'seatd' 'xorg-xwayland' 'glib2'
         'libxcb' 'libxkbcommon' 'pcre2' 'libwlroots-0.20.so' 'libscenefx-0.5.so'
         'cjson' 'xcb-util-wm')
makedepends=('meson' 'wlroots0.20' 'scenefx')
source=("${pkgname}-${_tag}.tar.gz::https://github.com/CarlosDLMC/mango/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('3bedaa858b9641fa2c2339d5be28401888e084f47b6b5b89a4ec9355aa7ad083')

build() {
	arch-meson "${_pkgname}-${_tag}" build
	meson compile -C build
}

package() {
	meson install -C build --destdir "${pkgdir}"
}
