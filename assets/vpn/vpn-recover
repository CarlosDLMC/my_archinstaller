#!/bin/bash
# vpn-recover [name]   get the network back after a tunnel died, and connect <name>
# vpn-recover --off    the same clean-up without connecting: no VPN, no block
#
# A tunnel that dies without its PostDown leaves its killswitch rule behind, and
# that rule blocks everything. This used to delete only the rule named after the
# config you picked - after a server died you usually pick another one, so the
# dead tunnel's rule stayed, nothing could get out, and it still said "VPN
# connected". A tunnel whose interface was still there could not be brought up
# at all ("already exists"). And when `wg-quick up` failed, it added a
# block-everything rule even where no killswitch had been active, leaving the
# machine offline until a reboot. Now: every WireGuard interface still up comes
# down, every killswitch rule goes, then the tunnel comes up; if that fails,
# only the rules that were in force before go back.

WIREGUARD_DIR="/etc/wireguard"
TAG="wireguard-killswitch"
FWD_CHAIN="wireguard-killswitch-fwd"   # the routed (Docker, VM) half, in FORWARD

if [[ $EUID -ne 0 ]]; then
    exec sudo /usr/local/bin/vpn-recover "$@"
fi

mapfile -t configs < <(
    find "$WIREGUARD_DIR" -maxdepth 1 -type f -name '*.conf' \
        -printf '%f\n' | sed 's/\.conf$//' | sort
)

off=false
vpn=""
if [[ "${1:-}" == "--off" ]]; then
    off=true
elif [[ ${#configs[@]} -eq 0 ]]; then
    echo "No WireGuard configs found."
    exit 1
elif [[ $# -eq 0 ]]; then
    echo
    echo "Available WireGuard configs:"
    echo

    for i in "${!configs[@]}"; do
        printf "  %d) %s\n" "$((i + 1))" "${configs[$i]}"
    done

    echo
    read -rp "Select VPN [1-${#configs[@]}]: " choice

    if ! [[ "$choice" =~ ^[0-9]+$ ]] ||
       (( choice < 1 || choice > ${#configs[@]} )); then
        echo "Invalid selection."
        exit 1
    fi

    vpn="${configs[$((choice - 1))]}"
else
    vpn="$1"
fi

if [[ "$off" == false && ! -f "$WIREGUARD_DIR/$vpn.conf" ]]; then
    echo "Config not found: $WIREGUARD_DIR/$vpn.conf"
    exit 1
fi

# 1. Every WireGuard interface still up comes down. Through wg-quick when it has
# a config (that also takes out its DNS and routes); otherwise just the link.
for iface in $(wg show interfaces 2>/dev/null); do
    echo "Bringing down $iface..."
    if [[ -f "$WIREGUARD_DIR/$iface.conf" ]] && wg-quick down "$iface" >/dev/null 2>&1; then
        continue
    fi
    ip link delete dev "$iface" 2>/dev/null || true
done

# 2. Every killswitch rule left in OUTPUT, whichever config put it there - saved
# first, as `iptables -S` prints them, so a failed connect can put back exactly
# what was in force.
mapfile -t stale < <(iptables -S OUTPUT 2>/dev/null | grep -- "--comment $TAG")
mapfile -t stale_fwd < <(iptables -S FORWARD 2>/dev/null | grep -- "--comment $TAG")
mapfile -t fwd_chain < <(iptables -S "$FWD_CHAIN" 2>/dev/null | grep '^-A ')
if [[ $(( ${#stale[@]} + ${#stale_fwd[@]} )) -gt 0 ]]; then
    echo "Removing $(( ${#stale[@]} + ${#stale_fwd[@]} )) stale killswitch rule(s)..."
    # By line number, highest first, so the numbers below stay valid.
    for chain in OUTPUT FORWARD; do
        for n in $(iptables -L "$chain" -n --line-numbers 2>/dev/null | awk -v tag="$TAG" '$0 ~ tag { print $1 }' | sort -rn); do
            iptables -D "$chain" "$n"
        done
    done
    iptables -F "$FWD_CHAIN" 2>/dev/null
    iptables -X "$FWD_CHAIN" 2>/dev/null
else
    echo "No stale killswitch rules."
fi

if [[ "$off" == true ]]; then
    echo
    echo "No VPN, and nothing blocked: the network is in the clear."
    exit 0
fi

echo "Starting $vpn..."
echo

if ! wg-quick up "$vpn"; then
    echo
    echo "WireGuard failed to start."
    if [[ $(( ${#stale[@]} + ${#stale_fwd[@]} )) -gt 0 ]]; then
        # Fail closed, as the killswitch that was in force would have.
        for rule in "${stale[@]}"; do
            read -ra spec <<< "${rule#-A OUTPUT }"
            iptables -I OUTPUT "${spec[@]}"
        done
        if [[ ${#fwd_chain[@]} -gt 0 ]]; then
            iptables -N "$FWD_CHAIN" 2>/dev/null
            for rule in "${fwd_chain[@]}"; do
                read -ra spec <<< "${rule#-A $FWD_CHAIN }"
                iptables -A "$FWD_CHAIN" "${spec[@]}"
            done
        fi
        for rule in "${stale_fwd[@]}"; do
            read -ra spec <<< "${rule#-A FORWARD }"
            iptables -I FORWARD "${spec[@]}"
        done
        echo "The killswitch that was in force is back: nothing gets out."
        echo "Try another server (vpn-recover), or unblock with: vpn-recover --off"
    else
        echo "No killswitch was in force, so the network is not blocked."
    fi
    exit 1
fi

echo
echo "VPN connected: $vpn"
if iptables -S OUTPUT 2>/dev/null | grep -- "--comment $TAG" | grep -q -- "! -o $vpn "; then
    echo "Killswitch active."
else
    echo "This config has no killswitch (a split tunnel, or add-wireguard-killswitch-to-configs not run)."
fi
