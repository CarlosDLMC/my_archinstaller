[Plymouth Theme]
Name=Soviet
Description=The repo logo on black, with the stock spinner and the LUKS prompt underneath. Ignores the firmware (BGRT) logo.
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
MonospaceFont=Adwaita Mono 12
ImageDir=/usr/share/plymouth/themes/soviet
# Layout, as fractions of (screen - element) so it scales from 1080p to 4K:
#   logo (watermark.png)   0.15  -> upper third of the screen
#   password dialog/title  0.68  -> clear of the 560 px logo even at 1080p
#   spinner (animation)    0.80
#
# The logo was 400 px at 0.35. A taller picture pushes its bottom edge down
# twice over - the image itself grows, and 0.35 of a smaller (screen - image)
# still leaves most of the growth below the anchor - so at 560 px and 0.35 it
# overlapped the password prompt on a 1080p screen (bottom 742 vs prompt 680).
# Moving the anchor to 0.15 buys back more than the extra height costs: the
# bottom edge lands at 638 on 1080p and 692 on 1440p, both clear of the prompt.
# 560 px is the largest that still clears 1080p; go taller and only 1440p+ fits.
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.68
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.68
HorizontalAlignment=.5
VerticalAlignment=.80
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.15
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x606060
ProgressBarForegroundColor=0xffffff
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

# UseFirmwareBackground=false is the whole point: the CachyOS theme paints the
# motherboard's own logo (ACPI BGRT) as the background and adds a small
# watermark. This one paints black and shows the repo logo instead, so with
# "Boot Logo Display" disabled in the BIOS the vendor logo never appears.
[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
