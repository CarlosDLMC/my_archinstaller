[Plymouth Theme]
Name=Soviet
Description=The repo logo on black, with the stock spinner and the LUKS prompt underneath. Ignores the firmware (BGRT) logo.
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
MonospaceFont=Adwaita Mono 12
ImageDir=/usr/share/plymouth/themes/soviet
# Layout, as fractions of (screen - element) so it scales from 1080p to 4K:
#   logo (watermark.png)   0.05  -> just under the top edge
#   password dialog/title  0.68
#   spinner (animation)    0.80
#
# The logo is a downscale of icons/aisaka.icon (1920x1920, trim 1449x1920) -
# never an upscale. Plymouth draws the watermark at its native pixel size and
# only the anchor is a fraction of the screen, so the height belongs to the
# panel: icons/ carries one cut each and install-scripts/plymouth.sh installs
# the one matching the smallest connected screen as watermark.png.
#
#   panel   cut        top   bottom   prompt 0.68*(H-80)   clearance
#   1080p    468x620    23     643      680                  37
#   1440p    649x860    29     889      925                  36   <- this desktop
#   2160p   1011x1340   41    1381     1414                  33
#
# Each is the tallest that still clears the prompt at anchor 0.05, so all three
# fill the same fraction of their screen. The anchor was 0.15 with a 560 px cut
# sized for 1080p, which left 233 px of black above the prompt on 1440p.
#
# A 4K panel small enough to be HiDPI (plymouth's own guess, roughly >192 dpi)
# makes plymouth double everything and halves the logical screen, which makes
# the 1080p cut the right one; plymouth.force-scale=1 on the kernel command
# line overrides that guess.
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.68
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.68
HorizontalAlignment=.5
VerticalAlignment=.80
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.05
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x606060
ProgressBarForegroundColor=0xffffff
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

# UseFirmwareBackground=false is the whole point: the CachyOS theme paints the
# motherboard's own logo (ACPI BGRT) as the background and adds a small
# watermark. This one paints black and shows the repo logo instead, so with
# "Boot Logo Display" disabled in the BIOS the vendor logo never appears.
[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
